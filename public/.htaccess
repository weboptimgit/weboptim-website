RewriteRule ^sk/o-nas/$ https://www.weboptim.sk/o-nas [R=301,L]
RewriteRule ^sk/preco-su-strukturovane-data-zasadne-pre-seo/$ https://www.weboptim.sk/preco-su-strukturovane-data-zasadne-pre-seo [R=301,L]
RewriteRule ^sk/sluzby/$ https://www.weboptim.sk/sluzby [R=301,L]
RewriteRule ^sk/sluzby/digitalizacia-a-automatizacia-procesov/$ https://www.weboptim.sk/sluzby/digitalizacia-a-automatizacia-procesov [R=301,L]
RewriteRule ^sk/sluzby/ppc/$ https://www.weboptim.sk/sluzby/ppc [R=301,L]
RewriteRule ^sk/sluzby/seo/$ https://www.weboptim.sk/sluzby/seo [R=301,L]
RewriteRule ^sk/sluzby/tvorba-eshopu/$ https://www.weboptim.sk/sluzby/tvorba-eshopu [R=301,L]
RewriteRule ^sk/sluzby/tvorba-webstranok/$ https://www.weboptim.sk/sluzby/tvorba-webstranok [R=301,L]
RewriteRule ^sk/services/ppc/$ https://www.weboptim.sk/sluzby/ppc [R=301,L]
RewriteRule ^sk/50-seo-prikazov-pre-chatgpt-od-openai/$ https://www.weboptim.sk/blog/50-seo-prikazov-pre-chatgpt-od-openai [R=301,L]

RewriteRule ^star-reviews-star-sales-the-power-of-customer-feedback-in-ecommerce/$ https://www.weboptim.eu/blog/star-reviews-star-sales-the-power-of-customer-feedback-in-ecommerce [R=301,L]
RewriteRule ^the-best-e-commerce-solution-for-your-business-how-to-choose-the-right-one/$ https://www.weboptim.eu/blog/the-best-e-commerce-solution-for-your-business-how-to-choose-the-right-one [R=301,L]
RewriteRule ^why-structured-data-is-essential-for-your-seo$ https://www.weboptim.eu/blog/why-structured-data-is-essential-for-your-seo [R=301,L]

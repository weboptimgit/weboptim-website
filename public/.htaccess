<IfModule mod_rewrite.c>
RewriteEngine On
Options -MultiViews
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Force WWW for apex domains
RewriteCond %{HTTP_HOST} ^weboptim\.(eu|cz|sk)$ [NC]
RewriteRule ^ https://www.weboptim.%1%{REQUEST_URI} [R=301,L]

# -------------------------
# OLD -> NEW redirects (from your table)
# (place them HERE)
# -------------------------

RewriteRule ^about-us/$ https://www.weboptim.eu/about [R=301,L]
RewriteRule ^about-us$ https://www.weboptim.eu/about [R=301,L]
RewriteRule ^blog/ai-artificial-intelligence/$ https://www.weboptim.eu/blog/ai-artificial-intelligence [R=301,L]
RewriteRule ^blog/online-marketing/$ https://www.weboptim.eu/blog/online-marketing [R=301,L]
RewriteRule ^blog/webs-and-eshops/$ https://www.weboptim.eu/blog/webs-and-eshops [R=301,L]
RewriteRule ^contact/$ https://www.weboptim.eu/contact [R=301,L]

RewriteRule ^cz/?$ https://www.weboptim.cz [R=301,L]
RewriteRule ^cz/blog/online-marketing/$ https://www.weboptim.cz/blog/online-marketing [R=301,L]
RewriteRule ^cz/blog/ui-umela-inteligence/$ https://www.weboptim.cz/blog/ai-umela-inteligence [R=301,L]
RewriteRule ^cz/blog/weby-a-eshopy/$ https://www.weboptim.cz/blog/weby-a-eshopy [R=301,L]

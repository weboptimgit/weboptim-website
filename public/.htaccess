RewriteRule ^cz/o-nas/$ https://www.weboptim.cz/o-nas [R=301,L]
RewriteRule ^cz/proc-jsou-strukturovana-data-zasadni-pro-seo/$ https://www.weboptim.cz/proc-jsou-strukturovana-data-zasadni-pro-seo [R=301,L]
RewriteRule ^cz/sluzby/$ https://www.weboptim.cz/sluzby [R=301,L]
RewriteRule ^cz/sluzby/digitalizace-a-automatizace-procesu/$ https://www.weboptim.cz/sluzby/digitalizace-a-automatizace-procesu [R=301,L]
RewriteRule ^cz/sluzby/ppc/$ https://www.weboptim.cz/sluzby/ppc [R=301,L]
RewriteRule ^cz/sluzby/seo/$ https://www.weboptim.cz/sluzby/seo [R=301,L]
RewriteRule ^cz/sluzby/tvorba-eshopu/$ https://www.weboptim.cz/sluzby/tvorba-eshopu [R=301,L]
RewriteRule ^cz/sluzby/tvorba-webstranek/$ https://www.weboptim.cz/sluzby/tvorba-webstranek [R=301,L]
RewriteRule ^cz/services/ecommerce-website/$ https://www.weboptim.cz/sluzby/tvorba-eshopu [R=301,L]
RewriteRule ^cz/services/building-a-website/$ https://www.weboptim.cz/sluzby/tvorba-webstranek [R=301,L]
RewriteRule ^cz/services/digitalization-and-automation/$ https://www.weboptim.cz/sluzby/digitalizace-a-automatizace-procesu [R=301,L]

RewriteRule ^services/$ https://www.weboptim.eu/services [R=301,L]
RewriteRule ^services/building-a-website/$ https://www.weboptim.eu/services/building-website [R=301,L]
RewriteRule ^services/digitalization-and-automation/$ https://www.weboptim.eu/services/digitalization-and-automation [R=301,L]
RewriteRule ^services/ecommerce-website/$ https://www.weboptim.eu/services/ecommerce-website [R=301,L]
RewriteRule ^services/ppc/$ https://www.weboptim.eu/services/ppc [R=301,L]
RewriteRule ^services/seo/$ https://www.weboptim.eu/services/seo [R=301,L]

RewriteRule ^sk/?$ https://www.weboptim.sk [R=301,L]
RewriteRule ^sk/blog/online-marketing/$ https://www.weboptim.sk/blog/online-marketing [R=301,L]
RewriteRule ^sk/blog/ui-umela-inteligencia/$ https://www.weboptim.sk/blog/ai-umela-inteligencia [R=301,L]
RewriteRule ^sk/blog/weby-a-eshopy/$ https://www.weboptim.sk/blog/weby-a-eshopy [R=301,L]
RewriteRule ^sk/hviezde-recenzie-hviezdne-trzby-sila-zakaznickych-recenzii-v-ecommerce/$ https://www.weboptim.sk/hviezde-recenzie-hviezdne-trzby-sila-zakaznickych-recenzii-v-ecommerce [R=301,L]
RewriteRule ^sk/kontakt/$ https://www.weboptim.sk/kontakt [R=301,L]

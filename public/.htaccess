<IfModule mod_rewrite.c>
  RewriteEngine On
  Options -MultiViews

  # TEST (docasne)
  RewriteRule ^__htaccess_test__$ index.html [L,R=302]

  RewriteBase /

  # --- TRAILING SLASH (SEO) ---
  # presmeruj /nieco -> /nieco/ (okrem realnych suborov a priecinkov)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/ [R=301,L]

  # existujuce subory/adresare nechaj
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule . index.html [L]
</IfModule>
